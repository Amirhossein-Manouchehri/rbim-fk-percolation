# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Bulk, regenerable output: disorder realizations, pickles.
data/
*.pkl

# LaTeX build artefacts
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Figures and the derivation note are regenerable, but small and worth keeping,
# so results/figures and docs are tracked; scratch images elsewhere are not.
/*.png
/*.pdf

# Scan summaries under results/ are deliberately tracked.  They are aggregated
# observables rather than configurations -- tens of kilobytes each -- so keeping
# them in the repository makes the analysis reproducible from a clone alone.
# If a future run starts writing per-realization data, revisit this.
